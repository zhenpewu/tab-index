{
  "manifest_version": 3,
  "name": "Tab Index",
  "version": "0.1.0",
  "description": "Search, switch, and close duplicate tabs.",
  "permissions": ["tabs", "storage", "contextualIdentities"],
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "action": {
    "default_title": "Tab Index",
    "default_popup": "popup/index.html"
  },
  "options_ui": {
    "page": "options/index.html",
    "open_in_tab": true
  },
  "commands": {
    "search-tabs": {
      "suggested_key": {
        "mac": "Command+Shift+L"
      },
      "description": "Search open tabs"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "tab-index@zhenpewu",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"],
        "optional": []
      }
    }
  }
}
