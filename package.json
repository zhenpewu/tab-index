{
  "name": "tab-index",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "vite build",
    "lint:extension": "web-ext lint --source-dir dist",
    "package:source": "node scripts/package-source.mjs",
    "package": "npm run build && web-ext build --source-dir dist --artifacts-dir web-ext-artifacts --overwrite-dest && npm run package:source",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run lint:extension"
  },
  "dependencies": {
    "fuse.js": "7.5.0",
    "preact": "11.0.0"
  },
  "devDependencies": {
    "@babel/core": "8.0.7",
    "@babel/eslint-parser": "8.0.7",
    "@babel/preset-typescript": "8.0.7",
    "@eslint/js": "10.0.1",
    "@testing-library/preact": "3.2.4",
    "@testing-library/user-event": "14.6.7",
    "@types/firefox-webext-browser": "143.0.1",
    "@types/node": "26.6.4",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.3",
    "web-ext": "10.7.0"
  },
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  }
}
